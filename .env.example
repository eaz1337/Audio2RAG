# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Read from the environment only — never logged, never written into meta.json
# (CLAUDE.md "Secrets").

# Required only if config.yaml asr.backend is assemblyai or deepgram.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# Required only if asr.backend is whisper-local AND asr.whisper_local.diarize is true.
HF_TOKEN=
